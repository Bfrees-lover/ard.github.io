{
  "appId": "com.arduino.learn",
  "productName": "Arduino Learn",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "src/electron/**/*"
  ],
  "win": {
    "target": "nsis",
    "icon": "public/favicon.ico"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true
  }
}